:80 {
	redir /api /api/ 308

	handle_path /api/* {
		reverse_proxy api:8001
	}

	# handle, а не handle_path: приложение само отдаёт картинки на /ml-assets
	# (см. ml/assets.py, APIRouter(prefix="/ml-assets")), префикс срезать нельзя.
	handle /ml-assets/* {
		reverse_proxy 100.64.0.5:8010
	}

	handle {
		reverse_proxy frontend:3000
	}
}
