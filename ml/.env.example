# DeepSeek (LLM агента). model=deepseek-flash по умолчанию, можно переопределить DEEPSEEK_MODEL
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# Эмбеддинги нужны для поиска правил агента (handrules): fuse = вектора + BM25.
# device=cpu по умолчанию: на macOS сборка под MPS падает в кернелах при повторном эмбеддинге.
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# Своя папка под chroma-индекс правил (по умолчанию ml/chroma_handrules).
# HANDRULES_CHROMA_DIR=./chroma_handrules

# Langfuse tracing — ключи: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

# AI-сводки тем статистики (summaries.py). По умолчанию раз в минуту проверяем новые
# отзывы и генерируем сводку только для изменившихся тем.
# SUMMARY_POLL_SECONDS=60
# SUMMARY_FIRST_DELAY=10
# SUMMARY_GENERATE_PAUSE=1
# SUMMARY_DISABLED=1
