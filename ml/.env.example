# DeepSeek (LLM агента). model=deepseek-flash по умолчанию, можно переопределить DEEPSEEK_MODEL
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# Эмбеддинги нужны были только для search — RAG отключён, переменные не читаются.
# EMBED_MODEL=BAAI/bge-m3
# EMBED_DEVICE=cpu

# Langfuse tracing — ключи: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local
